-- !query
SELECT CASE
         WHEN a = 1 THEN 'CN'
         WHEN a = 2 THEN 'HK'
         ELSE 'Other'
       END AS SLR_CNTRY,
       CASE
         WHEN slr_cntry IN( 'CN' ) THEN 'GC'
         WHEN slr_cntry = 'HK' THEN 'HK'
         ELSE 'Other'
       END AS SLR_REGION,
       CASE
         WHEN slr_region IN ( 'GC' ) THEN 'Managed'
         WHEN slr_region = 'US' AND b = 1 THEN 'Managed'
         ELSE 'Unmanaged'
       END AS manage_flag,
       k
FROM   v1
GROUP  BY slr_cntry,
          slr_region,
          manage_flag,
          k
-- !query schema
struct<SLR_CNTRY:string,SLR_REGION:string,manage_flag:string,k:int>
-- !query output
CN	GC	Managed	1
HK	HK	Unmanaged	1


-- !query
SELECT CASE
         WHEN a = 1 THEN 'CN'
         WHEN a = 2 THEN 'HK'
         ELSE 'Other'
       END AS SLR_CNTRY,
       CASE
         WHEN slr_cntry IN( 'CN' ) THEN 'GC'
         WHEN slr_cntry = 'HK' THEN 'HK'
         ELSE 'Other'
       END AS SLR_REGION,
       CASE
         WHEN slr_region IN ( 'GC' ) THEN 'Managed'
         WHEN slr_region = 'US' AND b = 1 THEN 'Managed'
         ELSE 'Unmanaged'
       END AS manage_flag,
       k
FROM   v1
GROUP  BY 1,
          2,
          3,
          4
-- !query schema
struct<SLR_CNTRY:string,SLR_REGION:string,manage_flag:string,k:int>
-- !query output
CN	GC	Managed	1
HK	HK	Unmanaged	1


-- !query
SELECT t1.a,
       CASE WHEN t1.b > 0 THEN 1 ELSE 0 END AS FLAG,
       Sum(flag) OVER (partition BY t1.a) AS Sum_flag,
       CASE WHEN sum_flag > 0 THEN 1 ELSE 0 END
FROM   v1 t1
GROUP  BY 1,
          2
-- !query schema
struct<a:int,FLAG:int,Sum_flag:bigint,CASE WHEN (sum(CASE WHEN (b > 0) THEN 1 ELSE 0 END) OVER (PARTITION BY a ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) > 0) THEN 1 ELSE 0 END:int>
-- !query output
1	1	1	1
2	1	1	1
